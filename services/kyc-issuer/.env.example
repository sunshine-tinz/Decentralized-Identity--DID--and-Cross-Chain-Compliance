PORT=3001

# Issuer authentication. Format: "<apiKey>:<192-hex-BLS-pubkey>", comma separated.
# Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value.
ISSUER_KEYS=

# Attributes this deployment may issue (comma separated).
ALLOWED_ATTRIBUTES=kyc_passed,accredited_investor,not_sanctioned,over_18

# Browser origins allowed to call the API. Empty means no cross-origin access.
CORS_ORIGIN=

# Request-body limit and rate limiting for unauthenticated submissions.
MAX_BODY_SIZE=6mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# On-chain issuance. All four values are required for issuer approval to write
# credentials to the VC Verifier. ISSUER_SECRET_KEY must belong to an address
# registered on-chain with VCVerifier.add_issuer. Never commit a real value.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
VC_VERIFIER_CONTRACT_ID=
ISSUER_SECRET_KEY=

# Credential lifetime in ledgers for on-chain issuance (~30 days at 5 s/ledger).
CREDENTIAL_TTL_LEDGERS=518400

# Credential lifetime in days for the local placeholder envelope.
CREDENTIAL_TTL_DAYS=90

# Placeholder credential issuance. The service cannot produce verifiable
# BLS12-381 credentials yet, so issuance is disabled unless this is "true".
# Enabling it produces explicitly non-verifiable credentials.
PLACEHOLDER_ISSUANCE_ENABLED=false
