PORT=3001

# Issuer authentication. Format: "<apiKey>:<stellarG-or-192hex>", comma separated.
# Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value.
ISSUER_KEYS=

# AES-256-GCM encryption keys at rest (supports rotation: "<keyId>:<64hex>,<oldKeyId>:<64hex>")
KYC_ENCRYPTION_KEYS=
PII_RETENTION_MS=86400000
RETRIEVAL_TOKEN_TTL_MS=900000

# SEP-10 Stellar Web Authentication
SEP10_SIGNING_KEY=
SEP10_HOME_DOMAIN=kyc-issuer.stellar-did.local
SEP10_JWT_SECRET=

# Attributes this deployment may issue (comma separated).
ALLOWED_ATTRIBUTES=kyc_passed,accredited_investor,not_sanctioned,over_18

# Browser origins allowed to call the API. Empty means no cross-origin access.
CORS_ORIGIN=

# Request-body limit and rate limiting for unauthenticated submissions.
MAX_BODY_SIZE=6mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Credential lifetime in days (clamped to 365).
CREDENTIAL_TTL_DAYS=90

# Placeholder credential issuance. The service cannot produce verifiable
# BLS12-381 credentials yet, so issuance is disabled unless this is "true".
# Enabling it produces explicitly non-verifiable credentials for plumbing tests.
PLACEHOLDER_ISSUANCE_ENABLED=false

# On-chain Soroban credential issuance (optional)
# When configured, approving a KYC request automatically calls VCVerifier.issue_credential on-chain.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
VC_VERIFIER_CONTRACT_ID=CDDVO64VECGNVZOKCGTBAEKVB27HE5P4JGZZTMMI5FZIY4SHWF5UM662
ISSUER_SECRET_KEY=
