# Stellar source
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
COMPLIANCE_CONTRACT_ID=CAZAZ3Y7HYVVP2DXWQM5QPJWVCBGO7SUDMVMPZQGNRURYWCYES74PUZW

# Optional: first ledger to scan when no cursor exists. Defaults to the latest.
START_LEDGER=
# Cursor, event queue, and identity mapping state, persisted across restarts.
CURSOR_FILE=.bridge-cursor.json
QUEUE_FILE=.bridge-queue.json
IDENTITY_STORE_FILE=.bridge-identities.json
BRIDGE_MAX_RETRIES=5
BRIDGE_RETRY_BASE_MS=2000

# EVM destination. All three are required or the bridge refuses to start.
EVM_RPC_URL=
EVM_RECEIVER_ADDRESS=
BRIDGE_PRIVATE_KEY=
